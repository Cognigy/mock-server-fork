{
  "title": "WebSocket response to return",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "delay": {
      "$ref": "#/definitions/delay"
    },
    "subprotocol": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "binary": {
            "type": "string",
            "format": "byte"
          },
          "delay": {
            "$ref": "#/definitions/delay"
          }
        }
      }
    },
    "matchers": {
      "type": "array",
      "description": "per-incoming-frame response rules; when set, an incoming frame matching a rule triggers that rule's responses",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frameType": {
            "enum": [
              "TEXT",
              "BINARY",
              "PING",
              "PONG",
              "ANY"
            ]
          },
          "textMatcher": {
            "$ref": "#/definitions/stringOrJsonSchema"
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "binary": {
                  "type": "string",
                  "format": "byte"
                },
                "delay": {
                  "$ref": "#/definitions/delay"
                }
              }
            }
          },
          "turns": {
            "type": "array",
            "description": "sequential turns; presence makes the matcher sequential (successive matches emit successive turns). Each turn is a list of frames to reply with; an empty inner array is a legal turn meaning matched-but-no-reply. Mutually exclusive with responses.",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "binary": {
                    "type": "string",
                    "format": "byte"
                  },
                  "delay": {
                    "$ref": "#/definitions/delay"
                  }
                }
              }
            }
          },
          "onExhausted": {
            "description": "behaviour once every turn has been emitted on a connection; defaults to IGNORE",
            "enum": [
              "REPEAT",
              "CLOSE",
              "IGNORE"
            ]
          }
        },
        "not": {
          "required": [
            "responses",
            "turns"
          ]
        }
      }
    },
    "templateType": {
      "enum": [
        "VELOCITY",
        "JAVASCRIPT",
        "MUSTACHE"
      ]
    },
    "closeConnection": {
      "type": "boolean"
    },
    "closeCode": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 4999
    },
    "graphqlSubscriptionFilter": {
      "type": "object",
      "additionalProperties": false,
      "description": "GraphQL subscription query filter for graphql-transport-ws protocol. When set, incoming subscribe messages are AST-matched against this filter.",
      "properties": {
        "type": {
          "description": "body-type discriminator emitted by the clients when serialising a GraphQL body; optional, and only GRAPHQL is meaningful here",
          "enum": [
            "GRAPHQL"
          ]
        },
        "query": {
          "type": "string"
        },
        "operationName": {
          "type": "string"
        },
        "variablesSchema": {
          "type": "string"
        },
        "selectionSetMatchType": {
          "enum": [
            "NORMALISED_STRING",
            "AST_EXACT",
            "AST_SUBSET"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "query"
      ]
    },
    "primary": {
      "type": "boolean"
    }
  },
  "definitions": {
  }
}
